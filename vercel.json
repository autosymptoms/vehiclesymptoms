{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "17 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/price-check",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/price-check/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
